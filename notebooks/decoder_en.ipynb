"""**تابع برای ایجاد پرامپ**"""

def create_prompt(sentence, intent, slots):

    sentence_text = ' '.join(sentence)
    slots_text = ' '.join(slots)
    prompt = f'Input: {sentence_text}\nOutput Intent: {intent}\nOutput Slots: {slots_text}'
    return prompt

